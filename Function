def money_function(choice):
    global money
    global profit
    money_requirement = 0
    if choice == 1:
        money_requirement += 1.5
    elif choice == 2:
        money_requirement += 2.5
    elif choice == 3:
        money_requirement += 3.0

    ampenny = int(input("How many pennies?:"))
    amnickel = int(input("How many nickels?:"))
    amdime = int(input("How many dimes?:"))
    amquarter = int(input("How many quarters?:"))
    penny_money = money["penny"] * ampenny
    nickel_money = money["nickel"] * amnickel
    dime_money = money["dime"] * amdime
    quarter_money = money["quarter"] * amquarter
    total_pay = penny_money + nickel_money + dime_money + quarter_money
    profit += total_pay
    if total_pay < money_requirement:

        profit -= total_pay
        return f"refunding the money. it is insufficient by ${money_requirement - total_pay}"
    elif total_pay > money_requirement:

        change = total_pay - money_requirement
        profit -= change

        return f"printing your change. it is ${change}. Enjoy!"
    else:
        return 2





