import random

EASY_LEVEL_TURNS = 10
HARD_LEVEL_TURNS = 5

#function to set difficulty
def set_difficulty():
    level = input("choose a difficulty. type 'easy' or 'hard':")
    if level == "easy":
        return EASY_LEVEL_TURNS
    else:
        return HARD_LEVEL_TURNS
def game():
    # way of choosing number between 1 and 100
    print("Welcome to the number guessing game!")
    print("I am thinking of a number between 1 and 100.")
    answer = random.randint(1,100)
    print(f"The answer was {answer}.")
    turns = set_difficulty()
    print(f"You have {turns} turns remaining.")
    #Function to check the number
    def check_answer(user_guess, actual_answer,turns):
        #checks answer against guess, returns the number of lives if it's wrong or right
        if user_guess > actual_answer:
            print("You guessed too high.")

            return turns - 1
        elif user_guess < actual_answer:
            print("You guessed too low.")

            return turns - 1
        else:
            print(f"You guessed correctly. The answer was {user_guess}")
    guess = 0
    while answer != guess:
     #Let user guess a number

        guess = int(input("Make a guess: "))


        turns = check_answer(guess, answer, turns)
        print(f"You have {turns} turns remaining.")
        if turns == 0:
            print("You have no more remaining guesses. You lose")
            return
    # Track the number of turns and reduce by 1 if they get it wrong
game()
